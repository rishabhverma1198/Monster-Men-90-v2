PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# JWT
JWT_SECRET=your_jwt_secret

# CORS
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info

# =========================================================
# NUBUS PAYMENT GATEWAY (Add these after account creation)
# =========================================================
NUBUS_API_KEY=your_nubus_api_key
NUBUS_SECRET_KEY=your_nubus_secret_key
NUBUS_MERCHANT_ID=your_nubus_merchant_id
NUBUS_MODE=test  # 'test' for development, 'live' for production
NUBUS_WEBHOOK_SECRET=your_webhook_secret  # Optional

# Frontend URL (for OAuth redirects, password reset link)
FRONTEND_URL=http://localhost:5173
# Backend URL (for Google OAuth callback – must match where backend runs)
BACKEND_URL=http://localhost:5000
# Admin contact (optional – order WhatsApp & Order Success page)
ADMIN_NAME=Admin
ADMIN_PHONE=919876543210
