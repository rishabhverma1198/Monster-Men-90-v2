{
  "name": "monstermen90-backend",
  "version": "1.0.0",
  "description": "MonsterMen90 E-commerce Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "prestart": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1",
    "predev": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1",
    "dev": "rimraf dist && tsc && concurrently \"tsc -w\" \"nodemon dist/server.js\"",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "kill-port": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1",
    "type-check": "tsc --noEmit",
    "test:api": "tsx test/api-test.ts",
    "test:comprehensive": "tsx test/comprehensive-test.ts",
    "test:setup": "tsx test/setup-user.ts",
    "test:verify-user": "tsx test/verify-and-setup-user.ts",
    "test:create-admin": "tsx test/create-admin-user.ts",
    "test:fix-password": "tsx test/fix-password.ts",
    "test:public": "tsx test/public-endpoints-test.ts",
    "test:manual": "echo 'See test/test-manual.md for manual testing steps'",
    "test:nimbuspost": "tsx test/nimbuspost-automated-test.ts",
    "test": "vitest run",
    "test:auth": "vitest run src/__tests__/auth.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "tsx scripts/complete-verification.ts",
    "verify:full": "npm run verify"
  },
  "keywords": [
    "ecommerce",
    "backend",
    "express",
    "typescript",
    "supabase"
  ],
  "author": "MonsterMen90 Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "uuid": "^13.0.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.11",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
